# rtms-compliance-sample-js
#
# Copy to .env and fill in real values. .env is gitignored and must stay that way.
#
#   cp .env.example .env
#
# NOT PRODUCTION READY. Environment files are fine for local development.
# In production, load these from AWS Secrets Manager, HashiCorp Vault, or your
# platform's secret store. See the README section "Not production ready".

# ─── Zoom RTMS SDK ──────────────────────────────────────────────────────────
# Read directly by @zoom/rtms. Both come from your Zoom App's OAuth
# credentials at https://marketplace.zoom.us.
ZM_RTMS_CLIENT=YOUR_ZOOM_CLIENT_ID_HERE
ZM_RTMS_SECRET=YOUR_ZOOM_CLIENT_SECRET_HERE

# Webhook Secret Token from your Zoom App's Event Subscriptions page.
# Used for HMAC-SHA256 signature verification. Never sent anywhere.
ZM_RTMS_WEBHOOK_SECRET=YOUR_ZOOM_WEBHOOK_SECRET_TOKEN_HERE

# SDK logging. Set LOG_FORMAT=json in production so logs are parseable.
# LOG_LEVEL=debug prints the RTMS join handshake, which is where credential
# and entitlement problems usually surface.
ZM_RTMS_LOG_LEVEL=info
ZM_RTMS_LOG_FORMAT=progressive
ZM_RTMS_LOG_ENABLED=true

# Optional. Path to a CA bundle if your network terminates TLS.
# ZM_RTMS_CA=/etc/ssl/certs/corporate-ca.pem

# Optional. Route RTMS WebSocket traffic through an inspecting proxy.
# Applied via client.setProxy() before join().
# RTMS_PROXY_URL=http://proxy.internal.example.com:3128

# ─── Zoom environment ───────────────────────────────────────────────────────
# Commercial Zoom:      https://zoom.us
# Zoom for Government:  https://zoomgov.com
# API and Marketplace hosts are derived from this; do not set them separately.
# RTMS media endpoints are NOT set here. They arrive in the webhook payload as
# server_urls and follow the account's environment automatically.
ZOOM_HOST=https://zoom.us

# ─── Application ────────────────────────────────────────────────────────────
PORT=3000

# Public HTTPS URL Zoom can reach. Use an ngrok static domain locally:
#   ngrok http 3000 --domain=your-subdomain.ngrok-free.app
PUBLIC_URL=https://YOUR-SUBDOMAIN.ngrok-free.app

# Generate each of these with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=YOUR_GENERATED_32_BYTE_HEX_HERE
JWT_SECRET=YOUR_GENERATED_32_BYTE_HEX_HERE
TOKEN_ENCRYPTION_KEY=YOUR_GENERATED_32_BYTE_HEX_HERE

# ─── Database ───────────────────────────────────────────────────────────────
# compose.yaml provides this Postgres instance for local development.
DATABASE_URL=postgresql://compliance:compliance@localhost:5432/compliance

# ─── Compliance rule packs ──────────────────────────────────────────────────
# Loaded from rule-packs/ at startup. An invalid pack exits the process rather
# than screening with partial rules.
# Shipped examples: fin-us-retail-v3, health-us-intake-v1
RULE_PACK_ID=fin-us-retail-v3

# Source language for transcription. Setting this explicitly skips the SDK's
# ~30 second language auto-detect, which would otherwise leave the opening of
# the call unscreened.
TRANSCRIPT_LANGUAGE=ENGLISH

# Seconds to suppress a repeat candidate for the same rule.
RULE_SUPPRESSION_WINDOW_SECONDS=60

# Seconds between disclosure-checklist evaluations.
DISCLOSURE_INTERVAL_SECONDS=20

# ─── LLM adjudication ───────────────────────────────────────────────────────
# OpenRouter by default. Free models work without a key; Claude and GPT-4o
# need one. Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_MODEL=anthropic/claude-sonnet-5
LLM_TIMEOUT_MS=5000

# ─── Supervisor escalation ──────────────────────────────────────────────────
# Optional. High-severity alerts POST here while the meeting is live.
# Unset means escalation is a no-op.
# SUPERVISOR_WEBHOOK_URL=https://your-internal-endpoint.example.com/compliance-alerts
