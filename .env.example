# rtms-compliance-sample-js
#
# Fastest path:
#
#   npm run env:init      writes .env from this file with secrets generated
#
# Or copy it yourself:
#
#   cp .env.example .env
#
# You can also skip most of this. Outside production the app generates its own
# signing secret and defaults the local URLs, so only the four values Zoom
# issues plus a rule pack are actually required to boot.
#
# NOT PRODUCTION READY. Environment files are fine for local development.
# In production, load these from AWS Secrets Manager, HashiCorp Vault, or your
# platform's secret store. See the README section "Not production ready".

# ─── Required: from your Zoom App at marketplace.zoom.us ────────────────────
# Read directly by @zoom/rtms. These cannot be generated, and the app will not
# start without them in any environment.
ZM_RTMS_CLIENT=YOUR_ZOOM_CLIENT_ID_HERE
ZM_RTMS_SECRET=YOUR_ZOOM_CLIENT_SECRET_HERE

# Webhook Secret Token from your app's Event Subscriptions page. Used for
# HMAC-SHA256 signature verification. Never sent anywhere.
ZM_RTMS_WEBHOOK_SECRET=YOUR_ZOOM_WEBHOOK_SECRET_TOKEN_HERE

# ─── Required: compliance configuration ─────────────────────────────────────
# Which rules are in force. Deliberately has no default, in any environment:
# a rule pack is a compliance decision and should never be implicit.
# Shipped examples: fin-us-retail-v3, health-us-intake-v1
RULE_PACK_ID=fin-us-retail-v3

# ─── Signing secret ─────────────────────────────────────────────────────────
# Signs the short-lived tokens the in-meeting panel uses for the WebSocket and
# the audit API. It is the only thing stopping one meeting's panel from
# subscribing to another meeting's compliance alerts.
#
# Generated automatically outside production, with a warning. An ephemeral
# value means panel tokens stop verifying after a restart, which is fine
# locally. NODE_ENV=production refuses to start without a real one.
JWT_SECRET=YOUR_GENERATED_32_BYTE_HEX_HERE

# ─── Zoom environment ───────────────────────────────────────────────────────
# Commercial Zoom:      https://zoom.us
# Zoom for Government:  https://zoomgov.com
# API and Marketplace hosts are derived from this; do not set them separately.
# RTMS media endpoints are NOT set here. They arrive in the webhook payload as
# server_urls and follow the account's environment automatically.
ZOOM_HOST=https://zoom.us

# ─── Application ────────────────────────────────────────────────────────────
PORT=3000

# Public HTTPS URL Zoom can reach. Required in production; defaults to
# http://localhost:$PORT in development. Use an ngrok static domain locally:
#   ngrok http 3000 --domain=your-subdomain.ngrok-free.app
PUBLIC_URL=https://YOUR-SUBDOMAIN.ngrok-free.app

# Required in production; defaults to the compose Postgres in development.
DATABASE_URL=postgresql://compliance:compliance@localhost:5432/compliance

# ─── Screening tunables ─────────────────────────────────────────────────────
# Explicit source language skips the SDK's ~30 second auto-detect, which would
# otherwise leave the opening of the call unscreened.
TRANSCRIPT_LANGUAGE=ENGLISH

# Seconds to suppress a repeat candidate for the same rule.
RULE_SUPPRESSION_WINDOW_SECONDS=60

# Seconds between disclosure-checklist evaluations.
DISCLOSURE_INTERVAL_SECONDS=20

# ─── LLM adjudication ───────────────────────────────────────────────────────
# OpenRouter by default. LLM_API_KEY is OPTIONAL: free models work without one,
# and if a call fails the alert is still emitted, marked unadjudicated.
# Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_MODEL=anthropic/claude-sonnet-5
LLM_TIMEOUT_MS=5000

# ─── Optional ───────────────────────────────────────────────────────────────
# High-severity alerts POST here while the meeting is live. Unset is a no-op.
# SUPERVISOR_WEBHOOK_URL=https://your-internal-endpoint.example.com/compliance-alerts

# Route RTMS WebSocket traffic through an inspecting proxy, applied via
# client.setProxy() before join(). Common in regulated networks.
# RTMS_PROXY_URL=http://proxy.internal.example.com:3128

# Path to a CA bundle if your network terminates TLS.
# ZM_RTMS_CA=/etc/ssl/certs/corporate-ca.pem

# SDK logging. Use json in production so logs are parseable. LOG_LEVEL=debug
# prints the RTMS join handshake, which is where credential and entitlement
# problems usually surface.
ZM_RTMS_LOG_LEVEL=info
ZM_RTMS_LOG_FORMAT=progressive
ZM_RTMS_LOG_ENABLED=true

# ─── Not used yet ───────────────────────────────────────────────────────────
# This sample makes no server-side Zoom API calls: panel identity comes from
# the Zoom Apps SDK, and the attendee roster comes from the RTMS
# onParticipantEvent callback. So there is no OAuth token exchange and nothing
# to encrypt at rest. If you add either, you will also want:
#
#   SESSION_SECRET=...          signs server-side sessions
#   TOKEN_ENCRYPTION_KEY=...    encrypts stored Zoom OAuth tokens
#
# Do not generate TOKEN_ENCRYPTION_KEY per boot. An ephemeral key silently
# makes previously encrypted rows undecryptable.
